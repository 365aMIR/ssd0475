---
/**
 * The vault window: a keypad that asks /api/vault whether the code is right.
 * The pin and the contents live in lib/vault.server.ts and only come back in
 * the response to a correct code, so neither is in the page source.
 * Styles: blocks/_vault.scss
 */
---

<div
    class="block-vault"
    data-vault
>
    <div class="block-vault-door">
        <p
            class="block-vault-display"
            data-vault-display
            aria-live="polite"
        >
            <span data-vault-code>____</span><small data-vault-status>locked</small>
        </p>
        <div class="block-vault-keys">
            {
                ['1', '2', '3', '4', '5', '6', '7', '8', '9'].map((n) => (
                    <button
                        type="button"
                        class="block-vault-key"
                        data-vault-key={n}
                    >
                        {n}
                    </button>
                ))
            }
            <button
                type="button"
                class="block-vault-key clear"
                data-vault-key="clear"
                aria-label="Wissen"
                >c</button
            >
            <button
                type="button"
                class="block-vault-key"
                data-vault-key="0"
                >0</button
            >
            <button
                type="button"
                class="block-vault-key"
                data-vault-key="back"
                aria-label="Terug"
                >←</button
            >
        </div>
        <p class="block-vault-hint"></p>
    </div>

    <div
        class="block-vault-inside"
        data-vault-inside
        hidden
    >
    </div>
</div>

<script>
    const root = document.querySelector<HTMLElement>('[data-vault]');
    if (root) {
        const display = root.querySelector<HTMLElement>('[data-vault-display]')!;
        const codeEl = root.querySelector<HTMLElement>('[data-vault-code]')!;
        const statusEl = root.querySelector<HTMLElement>('[data-vault-status]')!;
        const inside = root.querySelector<HTMLElement>('[data-vault-inside]')!;
        const keys = root.querySelectorAll<HTMLButtonElement>('[data-vault-key]');

        let code = '';
        let busy = false;

        const render = () => {
            codeEl.textContent = '*'.repeat(code.length).padEnd(4, '_');
        };

        const setStatus = (text: string, state?: 'wrong' | 'right') => {
            statusEl.textContent = text;
            display.classList.remove('wrong', 'right');
            if (state) {
                void display.offsetWidth; // restart the shake
                display.classList.add(state);
            }
        };

        const lock = (seconds: number) => {
            keys.forEach((k) => (k.disabled = true));
            let left = seconds;
            const tick = () => {
                if (left <= 0) {
                    keys.forEach((k) => (k.disabled = false));
                    setStatus('locked');
                    return;
                }
                statusEl.textContent = `wacht ${left--}s`;
                setTimeout(tick, 1000);
            };
            setStatus('', 'wrong');
            tick();
        };

        const open = (vault: { title: string; note: string; items: { label: string; href: string }[] }) => {
            const title = document.createElement('h3');
            title.className = 'block-vault-title';
            title.textContent = vault.title;
            const note = document.createElement('p');
            note.className = 'block-vault-note';
            note.textContent = vault.note;
            inside.replaceChildren(title, note);
            if (vault.items.length) {
                const list = document.createElement('div');
                list.className = 'block-vault-items';
                vault.items.forEach((item) => {
                    const a = document.createElement('a');
                    a.href = item.href;
                    a.textContent = item.label;
                    list.append(a);
                });
                inside.append(list);
            }
            inside.hidden = false;
            root.querySelector<HTMLElement>('.block-vault-door')!.hidden = true;
        };

        const submit = async () => {
            busy = true;
            try {
                const res = await fetch('/api/vault', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ pin: code }),
                });
                const data = await res.json();
                if (data.ok) {
                    setStatus('open', 'right');
                    setTimeout(() => open(data.vault), 500);
                    return;
                }
                code = '';
                render();
                if (data.locked) lock(data.locked);
                else setStatus('fout', 'wrong');
            } catch {
                code = '';
                render();
                setStatus('error', 'wrong');
            } finally {
                busy = false;
            }
        };

        const press = (key: string) => {
            if (busy) return;
            if (key === 'clear') code = '';
            else if (key === 'back') code = code.slice(0, -1);
            else if (/^\d$/.test(key) && code.length < 4) code += key;
            else return;
            render();
            if (code.length < 4) setStatus('locked');
            else submit();
        };

        keys.forEach((k) => k.addEventListener('click', () => press(k.dataset.vaultKey!)));

        // Typing works too once the vault has focus (click any key first).
        root.closest('.win')?.addEventListener('keydown', (e) => {
            const ev = e as KeyboardEvent;
            if (/^\d$/.test(ev.key)) press(ev.key);
            else if (ev.key === 'Backspace') press('back');
            else if (ev.key === 'Escape') press('clear');
            else return;
            ev.preventDefault();
        });
    }
</script>
