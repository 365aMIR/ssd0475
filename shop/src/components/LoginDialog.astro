---
/**
 * The login screen while the site is locked: a Windows-style log-in dialog in
 * the middle of the desktop. Posts to /api/login, which checks the password on
 * the server (lib/lock.server.ts).
 * Styles: blocks/_login.scss
 */
interface Props {
    /** The line next to the lock, from the admin (Teksten → Inlogscherm). */
    text?: string;
}
const { text = 'holdonnnn' } = Astro.props;
const status = Astro.url.searchParams.get('login');
const message = status === 'fout' ? 'verkeerd wachtwoord, probeer opnieuw.' : status === 'wacht' ? 'te vaak geprobeerd. wacht een minuut.' : null;

// The mail form below the login (api/subscribe.ts) answers with ?mail=...
const mail = Astro.url.searchParams.get('mail');
const mailMessage = mail === 'ok' ? 'sent.' : mail === 'fout' ? 'dat mailadres klopt niet.' : mail === 'wacht' ? 'even rustig, probeer het zo opnieuw.' : null;
---

<section
    class="block-login"
    role="dialog"
    aria-labelledby="login-title"
>
    <header class="block-login-bar">
        <span id="login-title">login</span>
        <span
            class="block-login-bar-btns"
            aria-hidden="true"
            ><span>?</span><span>x</span></span
        >
    </header>

    <div class="block-login-banner">
        <img
            src="/img/shop/logo-1.png"
            alt="southsidedinero"
            width="200"
            height="100"
        />
        <img
            src="/img/shop/nulnanul-eagle.png"
            alt="southsidedinero"
            width="200"
            height="100"
        />
        <!-- <span class="block-login-tag"></span> -->
    </div>

    <form
        class="block-login-form"
        method="post"
        action="/api/login"
    >
        <div class="block-login-intro">
            <svg
                width="44"
                height="52"
                viewBox="0 0 56 64"
                aria-hidden="true"
            >
                <path
                    d="M14 28V18a14 14 0 0 1 28 0v10"
                    fill="none"
                    stroke="#000300"
                    stroke-width="5"
                ></path>
                <rect
                    x="4"
                    y="28"
                    width="48"
                    height="34"
                    fill="#f5ee5a"
                    stroke="#000300"
                    stroke-width="2"
                ></rect>
                <rect
                    x="25"
                    y="38"
                    width="6"
                    height="12"
                    fill="#000300"
                ></rect>
            </svg>
            <p>{text}</p>
        </div>

        <div class="block-login-fields">
            <label for="login-user">user:</label>
            <input
                id="login-user"
                type="text"
                value="£su00ki"
                readonly
                autocomplete="username"
            />
            <label for="login-password">password:</label>
            <input
                id="login-password"
                name="password"
                type="password"
                autocomplete="current-password"
                required
                autofocus
            />
        </div>

        {
            message && (
                <p
                    class="block-login-error"
                    role="alert"
                >
                    {message}
                </p>
            )
        }

        <div class="block-login-buttons">
            <button type="submit">ok</button>
            <button type="reset">cancel</button>
        </div>
    </form>

    <form
        class="block-login-mail"
        method="post"
        action="/api/subscribe"
    >
        <div class="block-login-mail-row">
            <label
                class="visually-hidden"
                for="login-mail"
                >mail</label
            >
            <input
                id="login-mail"
                name="email"
                type="email"
                inputmode="email"
                autocomplete="email"
                placeholder="email"
                required
            />
            <button type="submit">submit</button>
        </div>
        <!-- Honeypot: hidden from people, bots fill it in. -->
        <div
            class="block-login-mail-trap"
            aria-hidden="true"
        >
            <label for="login-website">website</label>
            <input
                id="login-website"
                name="website"
                type="text"
                tabindex="-1"
                autocomplete="off"
            />
        </div>
        {
            mailMessage && (
                <p
                    class:list={['block-login-mail-message', { error: mail !== 'ok' }]}
                    role="status"
                >
                    {mailMessage}
                </p>
            )
        }
    </form>
</section>
