---
/**
 * The cart / receipt
 * shop-client.ts writes the lines in. 
 * Styles: blocks/_cart.scss
 */
---

<dialog
    class="block-cart"
    id="cart"
    aria-label="Winkelmand"
>
    <div class="block-cart-paper">
        <div
            class="block-cart-edge top"
            aria-hidden="true"
        >
        </div>
        <div class="block-cart-body">
            <div class="block-cart-head">
                <span class="block-cart-title">cart</span>
                <form method="dialog">
                    <button
                        class="button-close"
                        aria-label="Sluiten"
                        >x</button
                    >
                </form>
            </div>

            <img
                class="block-cart-logo"
                src="/img/shop/logo-8.png"
                alt="southsidedinero"
                width="170"
                height="85"
            />
            <p class="block-cart-meta">roermoney · 0475<br /><span id="bon-date"></span></p>

            <hr class="block-cart-dash" />

            <p
                class="block-cart-empty"
                id="bon-empty"
            >
                nog niks op de bon
            </p>
            <ul
                class="block-cart-lines"
                id="bon-lines"
                role="list"
            >
            </ul>

            <hr class="block-cart-dash" />

            <div class="block-cart-row"><span>subtotaal</span><span id="bon-subtotal">€ 0,00</span></div>
            <div class="block-cart-row block-cart-zone">
                <label for="bon-zone">verzenden naar</label>
                <select id="bon-zone"></select>
            </div>
            <div class="block-cart-row"><span>verzending</span><span id="bon-shipping"></span></div>

            <hr class="block-cart-double" />

            <div class="block-cart-total"><span>total</span><span id="bon-total">€ 0,00</span></div>

            <!-- Goes to Stripe (pages/api/checkout.ts); off while the receipt is empty. -->
            <button
                type="button"
                class="block-cart-checkout"
                id="bon-checkout"
                disabled
                >checkout</button
            >
            <p
                class="block-cart-note"
                id="bon-note"
            >
                ideal · bancontact · kaart
            </p>

            <svg
                class="block-cart-barcode"
                viewBox="0 0 220 40"
                preserveAspectRatio="none"
                aria-hidden="true"
            >
                <g fill="#000300">
                    <rect
                        x="0"
                        width="3"
                        height="40"
                    ></rect><rect
                        x="6"
                        width="1"
                        height="40"
                    ></rect><rect
                        x="10"
                        width="4"
                        height="40"
                    ></rect>
                    <rect
                        x="17"
                        width="2"
                        height="40"
                    ></rect><rect
                        x="22"
                        width="1"
                        height="40"
                    ></rect><rect
