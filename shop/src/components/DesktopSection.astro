---
/**
 * The blue/white desktop on the shop page: icons on the left, windows on top,
 * a taskbar along the bottom. It is the libre-dash desktop shrunk into a
 * section of the page, so it reuses Window.astro and the same window manager —
 * only scoped to this box instead of the whole viewport.
 * Styles: blocks/_desktop.scss
 */
export interface DesktopIcon {
    /** The data-win-id of the window it opens. */
    win: string;
    label: string;
    /** Image for the icon; omit for the yellow folder. */
    icon?: string;
}

interface Props {
    icons: DesktopIcon[];
    /**
     * Lockout mode (see lib/lock.server.ts): the desktop fills the whole screen
     * and the taskbar shows the log-in. The login dialog goes in the slot.
     */
    locked?: boolean;
    /** Text on the right of the taskbar. */
    brand?: string;
}

const { icons, locked = false, brand = 'southsidedinero' } = Astro.props;
---

<section
    class:list={['block-desktop', locked ? 'block-desktop--locked' : 'box shadow']}
    aria-label="southsidedinero desktop"
>
    <div
        class="block-desktop-area"
        id="desktop"
    >
        <ul
            class="block-desktop-icons"
            role="list"
        >
            {
                icons.map((item) => (
                    <li>
                        <button
                            type="button"
                            class="block-desktop-icon"
                            data-open-win={item.win}
                        >
                            {item.icon ? (
                                <img
                                    src={item.icon}
                                    alt=""
                                    width="56"
                                    height="46"
                                />
                            ) : (
                                <svg
                                    width="56"
                                    height="46"
                                    viewBox="0 0 56 46"
                                    aria-hidden="true"
                                >
                                    <path
                                        d="M2 8h18l5 5h29v31H2z"
                                        fill="#f5ee5a"
                                        stroke="#000300"
                                        stroke-width="2"
                                    />
                                    <path
                                        d="M2 16h52"
                                        stroke="#000300"
                                        stroke-width="2"
                                    />
                                </svg>
                            )}
                            <span class="block-desktop-icon-label">{item.label}</span>
                        </button>
                    </li>
                ))
            }
        </ul>

        <slot />
    </div>

    <footer class="block-desktop-taskbar">
        {locked && <span class="block-desktop-login">log in</span>}
        <div
            class="block-desktop-dock"
            data-taskbar-dock
        >
        </div>
        <span class="block-desktop-brand">{brand}</span>
    </footer>
</section>

<script is:inline>
    // libre-dash's window manager (layouts/Desktop.astro), pointed at this
    // section instead of the viewport. Changes from the original are marked.
    (() => {
        const desktop = document.getElementById('desktop');
        const dock = document.querySelector('.block-desktop [data-taskbar-dock]');
        const KEY = 'ssd:desktop'; // changed: own storage key

        let saved = {};
        try {
            saved = JSON.parse(localStorage.getItem(KEY) || '{}');
        } catch {}
        const save = () => {
            try {
                localStorage.setItem(KEY, JSON.stringify(saved));
            } catch {}
        };

        const clamp = (v, lo, hi) => Math.min(Math.max(v, lo), hi);
        let topZ = 10;

        // changed: on a phone the icons sit in a row across the top, so windows
        // start below them instead of beside them.
        const narrow = () => matchMedia('(max-width: 640px)').matches;

        const windows = [...desktop.querySelectorAll('.win')];
        const api = {};

        windows.forEach((win, i) => {
            const id = win.dataset.winId;
            const state = (saved[id] = saved[id] || {});
            if (win.dataset.open === 'false') state.open = false;
            else if (state.open === undefined) state.open = true;

            const place = (x, y) => {
                const maxX = Math.max(0, desktop.clientWidth - win.offsetWidth);
                const maxY = Math.max(0, desktop.clientHeight - win.offsetHeight);
                state.x = clamp(x, 0, maxX);
                state.y = clamp(y, 0, maxY);
                win.style.left = state.x + 'px';
                win.style.top = state.y + 'px';
            };

            const focus = () => {
                windows.forEach((w) => delete w.dataset.focused);
                win.dataset.focused = '';
                win.style.zIndex = ++topZ;
            };

            const setOpen = (open) => {
                state.open = open;
                win.hidden = !open;
                if (btn) btn.dataset.active = String(open);
                if (open) {
                    // changed: a window opened from an icon is pulled back into view, in
                    // case the desktop got narrower since it was last placed.
                    place(state.x ?? 0, state.y ?? 0);
                    focus();
                }
                save();
            };

            const cycle = () => {
                if (!state.open) return setOpen(true);
                if (win.dataset.focused === undefined) return focus();
                setOpen(false);
            };

            const btn = win.dataset.dock === 'false' ? null : document.createElement('button');
            if (btn) {
                btn.type = 'button';
                btn.className = 'taskbar-app';
                btn.textContent = win.dataset.winTitle;
                btn.addEventListener('click', cycle);
                dock.appendChild(btn);
            }

            document.addEventListener('win:toggle', (e) => {
                if (e.detail && e.detail.id === id) cycle();
            });
            // changed: icons and links open, they never close.
            api[id] = () => setOpen(true);

            if (state.w) win.style.width = Math.min(state.w, desktop.clientWidth) + 'px';
            if (state.h) win.style.height = Math.min(state.h, desktop.clientHeight) + 'px';
            win.hidden = !state.open;
            if (btn) btn.dataset.active = String(state.open);

            const offset = narrow() ? { x: 8, y: 112 } : { x: 132, y: 20 };
            const startX = state.x ?? Number(win.dataset.x ?? NaN);
            const startY = state.y ?? Number(win.dataset.y ?? NaN);
            const wasHidden = win.hidden;
            if (wasHidden) win.hidden = false;
            place(Number.isFinite(startX) ? startX : offset.x + i * 24, Number.isFinite(startY) ? startY : offset.y + i * 24);
            if (wasHidden) win.hidden = true;
            win.style.zIndex = ++topZ;

            const bar = win.querySelector('.win-bar');
            const grip = win.querySelector('.win-grip');

            const drag = (e, onMove) => {
                const target = e.currentTarget;
                target.setPointerCapture(e.pointerId);
                win.dataset.dragging = '';
                const move = (ev) => onMove(ev);
                const up = () => {
                    delete win.dataset.dragging;
                    target.removeEventListener('pointermove', move);
                    target.removeEventListener('pointerup', up);
                    target.removeEventListener('pointercancel', up);
                    save();
                };
                target.addEventListener('pointermove', move);
                target.addEventListener('pointerup', up);
                target.addEventListener('pointercancel', up);
            };

            bar.addEventListener('pointerdown', (e) => {
                if (e.button !== 0 || e.target.closest('.win-bar-btn')) return;
                focus();
                const rect = win.getBoundingClientRect();
                const offX = e.clientX - rect.left;
                const offY = e.clientY - rect.top;
                const box = desktop.getBoundingClientRect();
                drag(e, (ev) => place(ev.clientX - box.left - offX, ev.clientY - box.top - offY));
            });

            grip.addEventListener('pointerdown', (e) => {
                if (e.button !== 0) return;
                focus();
                const rect = win.getBoundingClientRect();
                drag(e, (ev) => {
                    state.w = clamp(ev.clientX - rect.left, 260, desktop.clientWidth);
                    state.h = clamp(ev.clientY - rect.top, 160, desktop.clientHeight);
                    win.style.width = state.w + 'px';
                    win.style.height = state.h + 'px';
                });
            });

            win.addEventListener('pointerdown', focus);
            win.querySelectorAll('[data-win-action]').forEach((el) => {
                const action = el.dataset.winAction;
                if (action === 'close' || action === 'minimise') {
                    el.addEventListener('click', () => setOpen(false));
                }
            });
        });

        save();

        // changed: icons, the quick-nav bar and any [data-open-win] link open a
        // window by id. Links that also point at #desktop scroll it into view.
        document.addEventListener('click', (e) => {
            const opener = e.target.closest('[data-open-win]');
            if (!opener) return;
            const open = api[opener.dataset.openWin];
            if (open) open();
        });

        addEventListener('resize', () => {
            windows.forEach((win) => {
                const s = saved[win.dataset.winId];
                if (!s || !s.open) return;
                if (s.w) win.style.width = Math.min(s.w, desktop.clientWidth) + 'px';
                if (s.h) win.style.height = Math.min(s.h, desktop.clientHeight) + 'px';
                win.style.left = clamp(s.x, 0, Math.max(0, desktop.clientWidth - win.offsetWidth)) + 'px';
                win.style.top = clamp(s.y, 0, Math.max(0, desktop.clientHeight - win.offsetHeight)) + 'px';
            });
        });
    })();
</script>
