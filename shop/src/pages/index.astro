---
import Base from '../layouts/Base.astro';
import Window from '../components/Window.astro';
import Radio from '../components/Radio.astro';
import DesktopSection from '../components/DesktopSection.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductModal from '../components/ProductModal.astro';
import CartReceipt from '../components/CartReceipt.astro';
import LogoCycle from '../components/LogoCycle.astro';
import Vault from '../components/Vault.astro';
import LoginDialog from '../components/LoginDialog.astro';
import { getCatalog } from '../lib/backend.server';
import { getContent, paragraphs } from '../lib/content.server';
import { ep } from '../data/ep';
import { getBeats } from '../lib/beats';

// Server-rendered like libre-dash: the radio reads public/beats on each request.
export const prerender = false;

const radioCards = getBeats();

// Lockout before a drop (lib/lock.server.ts, set per request in middleware.ts):
// visitors who haven't logged in get only the desktop with the login dialog.
// Nothing about the products is rendered for them.
const locked = Astro.locals.locked;

// Products and shipping zones from the Payload admin (or src/data/products.ts
// without one). Not even fetched for locked-out visitors.
const { products, zones } = locked ? { products: [], zones: [] } : await getCatalog();

// The texts per block, edited in the admin under Website → Teksten (lib/content.server.ts).
const content = await getContent();
const { hero, shop, drop, about, footer } = content;
const epText = content.ep;

const icons = [
    { win: 'drop', label: drop.windowTitle },
    { win: 'ep', label: epText.title, icon: ep.cover },
    { win: 'radio', label: 'radio', icon: '/img/cd_audio_cd-0_256.png' },
    { win: 'southsidedinero', label: 'southsidedinero', icon: '/img/shop/roermoney.png' },
    { win: 'vault', label: 'kloesoe', icon: '/img/shop/vault.svg' },
].filter((item) => !locked || item.win !== 'drop');

const quickNav = [
    { label: drop.windowTitle, win: 'drop' },
    { label: epText.title, win: 'ep' },
    { label: 'radio', win: 'radio' },
    { label: 'southsidedinero', win: 'southsidedinero' },
];

const clipTrack = ep.tracks[ep.videoTrack];
const fileName = (name: string) => name.toLowerCase().replace(/\s+/g, '_') + '.jpg';
---

<Base title="southsidedinero">
    {
        !locked && (
            <>
                <div class="block-top-header" />

                <header class="block-header">
                    <div class="container">
                        <div class="row">
                            <div class="col-12">
                                <div class="block-header-wrapper">
                                    <LogoCycle />
                                    <button
                                        type="button"
                                        class="block-header__cart button pink"
                                        data-cart-open
                                    >
                                        <svg
                                            width="18"
                                            height="18"
                                            viewBox="0 0 640 640"
                                            aria-hidden="true"
                                        >
                                            <!--!Font Awesome Pro v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2026 Fonticons, Inc.-->
                                            <path
                                                fill="#ffffff"
                                                d="M80 490.6L80 576L560 576L560 490.6C560 402.8 521 319.4 453.5 263.2L406.4 224L233.6 224L186.5 263.2C119 319.5 80 402.8 80 490.6zM192 64L248 176L392 176L448 64L192 64zM252 364.5C252 335.7 275.2 312.3 304 312L304 288L344 288L344 312L372 312L372 352L304.5 352C297.6 352 292 357.6 292 364.5C292 370.6 296.4 375.8 302.4 376.8L344.1 383.8C369.4 388 388 409.9 388 435.6C388 461.7 369 483.3 344 487.4L344 512.1L304 512.1L304 488.1L260 488.1L260 448.1L335.5 448.1C342.4 448.1 348 442.5 348 435.6C348 429.5 343.6 424.3 337.6 423.3L295.9 416.3C270.5 412 252 390.1 252 364.5z"
                                            />
                                            <path
                                                fill="#000"
                                                d="M432 176L208 176L208 224L432 224L432 176zM344 288L304 288L304 312C275.2 312.3 252 335.7 252 364.5C252 390.2 270.5 412.1 295.9 416.3L337.6 423.3C343.6 424.3 348 429.5 348 435.6C348 442.5 342.4 448.1 335.5 448.1L260 448.1L260 488.1L304 488.1L304 512.1L344 512.1L344 487.4C369 483.3 388 461.7 388 435.6C388 409.9 369.5 388 344.1 383.8L302.4 376.8C296.4 375.8 292 370.6 292 364.5C292 357.6 297.6 352 304.5 352L372 352L372 312L344 312L344 288z"
                                            />
                                        </svg>
                                        cart (<span data-cart-count>0</span>)
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </header>
            </>
        )
    }

    <main class="container">
        <div class="row">
            <div class="col-12">
                <div class="main">
                    {
                        !locked && (
                            <>
                                <section class="block-hero">
                                    <div class="block-hero-copy box shadow">
                                        <h6 class="block-hero-annotation">{hero.annotation}</h6>
                                        <h1 class="block-hero-header">{hero.title}</h1>
                                        {paragraphs(hero.intro).map((line) => (
                                            <p class="block-hero-content">{line}</p>
                                        ))}
                                        <div class="block-hero-button-wrapper">
                                            <a
                                                class="button yellow"
                                                href="#shop"
                                            >
                                                {hero.button}
                                            </a>
                                            <a
                                                class="link-mono"
                                                href="#desktop"
                                                data-open-win="ep"
                                            >
                                                {hero.epLink}
                                            </a>
                                        </div>
                                    </div>

                                    <div class="block-hero-window shadow">
                                        <div class="block-hero-window-bar">{hero.windowTitle}</div>
                                        <div class="block-hero-window-body">
                                            {products.map((p) => (
                                                <button
                                                    type="button"
                                                    class="block-hero-shot"
                                                    data-product-open={p.id}
                                                    aria-label={`Bekijk ${p.name}`}
                                                >
                                                    <img
                                                        src={p.photos[0]}
                                                        alt=""
                                                    />
                                                </button>
                                            ))}
                                        </div>
                                    </div>
                                </section>

                                <nav
                                    class="block-quicknav"
                                    aria-label="Snel naar"
                                >
                                    {quickNav.map((item) => (
                                        <a
                                            class="block-quicknav-link"
                                            href="#desktop"
                                            data-open-win={item.win}
                                        >
                                            {item.label}
                                        </a>
                                    ))}
                                </nav>

                                <section
                                    id="shop"
                                    class="block-products"
                                >
                                    <div
                                        class="block-splitter"
                                        aria-hidden="true"
                                    ></div>
                                    <div class="block-products-head box">
                                        <h2 class="block-products-title">
                                            {shop.title}<small class="block-products-count">{products.length} </small>
                                        </h2>
                                    </div>
                                    <div class="block-products-grid">
                                        {products.map((product) => (
                                            <ProductCard product={product} />
                                        ))}
                                    </div>
                                </section>

                                <div
                                    class="block-splitter"
                                    aria-hidden="true"
                                ></div>
                            </>
                        )
                    }

                    <DesktopSection
                        icons={icons}
                        locked={locked}
                        brand={locked ? content.locked.desktopText : undefined}
                    >
                        <Window
                            id="radio"
                            title="radio"
                            width={460}
                            open={!locked}
                        >
                            <Radio radioCards={radioCards} />
                        </Window>

                        {
                            !locked && (
                                <>
                                    <Window
                                        id="drop"
                                        title={drop.windowTitle}
                                        width={520}
                                        open={false}
                                    >
                                        <div class="block-drop">
                                            <p class="block-drop-path">
                                                <>
                                                    <span>{products.length} items</span>
                                                    <span>{drop.path}</span>
                                                </>
                                            </p>
                                            <div class="block-drop-files">
                                                {products.map((p) => (
                                                    <button
                                                        type="button"
                                                        class="block-drop-file"
                                                        data-product-open={p.id}
                                                    >
                                                        <img
                                                            src={p.photos[0]}
                                                            alt=""
                                                        />
                                                        <span>{fileName(p.name)}</span>
                                                    </button>
                                                ))}
                                            </div>
                                        </div>
                                    </Window>
                                </>
                            )
                        }

                        <Window
                            id="ep"
                            title={epText.title.replace(/['’]/g, '').replace(/[^a-z0-9]+/gi, '_')}
                            width={520}
                            open={false}
                        >
                            <div class="block-ep">
                                <div class="block-ep-head">
                                    <img
                                        class="block-ep-cover"
                                        src={ep.cover}
                                        alt={`Cover van ${epText.title}`}
                                        width="132"
                                        height="132"
                                    />
                                    <div>
                                        <p class="block-ep-annotation">{epText.annotation}</p>
                                        <h3 class="block-ep-header">{epText.title}</h3>
                                        <p class="block-ep-meta">
                                            {epText.artist} · {epText.year} · {epText.summary}
                                        </p>
                                        <p class="block-ep-meta">uit sinds {epText.released}</p>
                                        {
                                            ep.listenUrl && (
                                                <a
                                                    class="link-mono"
                                                    href={ep.listenUrl}
                                                    target="_blank"
                                                    rel="noopener"
                                                >
                                                    {epText.listenLabel}
                                                </a>
                                            )
                                        }
                                    </div>
                                </div>

                                <div class="block-ep-video">
                                    <span class="block-ep-video-label">clipper</span>
                                    {
                                        /* Thumbnail first, YouTube player only after a click: the page
                                        stays light and the play is a real view on the channel. */
                                    }
                                    {
                                        ep.youtubeId ? (
                                            <button
                                                type="button"
                                                class="block-ep-yt"
                                                data-yt-id={ep.youtubeId}
                                                data-yt-title={`${clipTrack.title} — ${epText.artist}`}
                                                aria-label={`Speel de videoclip van ${clipTrack.title} af`}
                                            >
                                                <img
                                                    src={`https://i.ytimg.com/vi/${ep.youtubeId}/hqdefault.jpg`}
                                                    alt=""
                                                    loading="lazy"
                                                />
                                                <span
                                                    class="block-ep-yt-play"
                                                    aria-hidden="true"
                                                >
                                                    <svg
                                                        width="22"
                                                        height="24"
                                                        viewBox="0 0 22 24"
                                                    >
                                                        <path
                                                            d="M2 2l18 10L2 22z"
                                                            fill="#000300"
                                                        />
                                                    </svg>
                                                </span>
                                            </button>
                                        ) : ep.video ? (
                                            <video
                                                src={ep.video}
                                                poster={ep.videoPoster ?? undefined}
                                                controls
                                                preload="none"
                                                playsinline
                                            />
                                        ) : (
                                            <span class="block-ep-video-empty">clip komt hier</span>
                                        )
                                    }
                                </div>
                                {
                                    ep.youtubeId && (
                                        <a
                                            class="link-mono block-ep-yt-link"
                                            href={`https://www.youtube.com/watch?v=${ep.youtubeId}`}
                                            target="_blank"
                                            rel="noopener"
                                        >
                                            {epText.youtubeLabel}
                                        </a>
                                    )
                                }

                                <div class="block-ep-player">
                                    <button
                                        type="button"
                                        class="button grey"
                                        id="ep-toggle"
                                        aria-pressed="false"
                                    >
                                        play
                                    </button>
                                    <div
                                        class="block-ep-progress"
                                        id="ep-progress"
                                        role="slider"
                                        tabindex="0"
                                        aria-label="Positie in nummer"
                                        aria-valuemin="0"
                                        aria-valuemax="100"
                                        aria-valuenow="0"
                                    >
                                        <div
                                            class="block-ep-progress-bar"
                                            id="ep-progress-bar"
                                        >
                                        </div>
                                    </div>
                                    <span
                                        class="block-ep-clock"
                                        id="ep-clock"
                                        >0:00</span
                                    >
                                    <audio
                                        id="ep-audio"
                                        preload="none"
                                    ></audio>
                                </div>

                                <ol class="block-ep-tracks">
                                    {
                                        ep.tracks.map((t, i) => (
                                            <li>
                                                <button
                                                    type="button"
                                                    class="block-ep-track"
                                                    data-ep-track={i}
                                                    data-src={encodeURI(t.file)}
                                                    aria-label={`Speel ${t.title}`}
                                                >
                                                    <span class="block-ep-nr">{i + 1}</span>
                                                    <span class="block-ep-name">{t.title}</span>
                                                    {i === ep.videoTrack && <span class="block-ep-clip">▶ clip</span>}
                                                    <span class="block-ep-time">{t.time}</span>
                                                </button>
                                            </li>
                                        ))
                                    }
                                </ol>

                                {
                                    ep.spotifyAlbumId && (
                                        <div class="block-ep-spotify">
                                            <span class="block-ep-spotify-label">spotify.exe</span>
                                            <iframe
                                                title={`${epText.title} op Spotify`}
                                                src={`https://open.spotify.com/embed/album/${ep.spotifyAlbumId}?utm_source=generator&theme=0`}
                                                width="100%"
                                                height="152"
                                                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                                                loading="lazy"
                                            />
                                        </div>
                                    )
                                }
                            </div>
                        </Window>

                        <Window
                            id="southsidedinero"
                            title={about.windowTitle}
                            width={500}
                            open={false}
                        >
                            <div class="block-roermoney">
                                <img
                                    class="block-roermoney-badge"
                                    src="/img/shop/roermoney.png"
                                    alt="roermoney southsidedinero 0475"
                                    width="150"
                                    height="150"
                                />
                                <div class="block-roermoney-text">
                                    <h3 class="block-roermoney-header">{about.title}</h3>
                                    {paragraphs(about.content).map((line) => (
                                        <p class="block-roermoney-content">{line}</p>
                                    ))}
                                </div>
                            </div>
                        </Window>

                        <Window
                            id="vault"
                            title="kloesoe"
                            width={320}
                            open={false}
                        >
                            <Vault />
                        </Window>
                        {locked && <LoginDialog text={content.locked.loginText} />}
                    </DesktopSection>

                    {
                        !locked && (
                            <>
                                <div
                                    class="block-splitter"
                                    aria-hidden="true"
                                ></div>
                            </>
                        )
                    }
                </div>
            </div>
        </div>
    </main>

    {
        !locked && (
            <>
                <footer class="block-footer">
                    <img
                        class="block-footer-image"
                        src="/img/shop/nulnanul-eagle.png"
                        alt="nulnanul"
                        width="2111"
                        height="674"
                        loading="lazy"
                    />
                    <div class="block-footer-bottom">
                        <div class="container">
                            <div class="row">
                                <div class="col-12">
                                    <div class="block-footer-bottom-wrapper">
                                        <span>{footer.copyright}</span>
                                        <span class="block-footer-bottom-links">
                                            {footer.links.map((link) => (
                                                <a href={link.url}>{link.label}</a>
                                            ))}
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </footer>

                <ProductModal />
                <CartReceipt />

                <script
                    type="application/json"
                    id="ssd-products"
                    set:html={JSON.stringify({ products, zones })}
                />
            </>
        )
    }
    <script>
        import { startShop } from '../lib/shop-client';
        startShop();

        // mama's tuin player: one <audio>, the tracklist picks what it plays and it
        // runs on through the EP. Only one thing makes noise at a time, so it and
        // the radio pause each other.
        {
            const audio = document.getElementById('ep-audio') as HTMLAudioElement | null;
            const toggle = document.getElementById('ep-toggle');
            const bar = document.getElementById('ep-progress-bar');
            const progress = document.getElementById('ep-progress');
            const clock = document.getElementById('ep-clock');
            const tracks = [...document.querySelectorAll<HTMLButtonElement>('[data-ep-track]')];
            let current = -1;

            const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

            const load = (i: number) => {
                if (!audio || !tracks[i]) return;
                current = i;
                audio.src = tracks[i].dataset.src ?? '';
                tracks.forEach((t, k) => t.setAttribute('aria-current', String(k === i)));
                audio.play().catch((err) => console.error('Error playing track:', err));
            };

            if (audio && toggle && bar && progress && clock) {
                tracks.forEach((t, i) =>
                    t.addEventListener('click', () => {
                        if (i === current) audio.paused ? audio.play() : audio.pause();
                        else load(i);
                    }),
                );

                toggle.addEventListener('click', () => {
                    if (current < 0) return load(0);
                    audio.paused ? audio.play() : audio.pause();
                });

                audio.addEventListener('play', () => {
                    toggle.textContent = 'pause';
                    toggle.setAttribute('aria-pressed', 'true');
                    document.querySelectorAll<HTMLAudioElement>('.audio-element').forEach((a) => a.pause());
                });
                audio.addEventListener('pause', () => {
                    toggle.textContent = 'play';
                    toggle.setAttribute('aria-pressed', 'false');
                });
                audio.addEventListener('timeupdate', () => {
                    const pct = audio.duration ? (audio.currentTime / audio.duration) * 100 : 0;
                    bar.style.width = `${pct}%`;
                    progress.setAttribute('aria-valuenow', String(Math.round(pct)));
                    clock.textContent = fmt(audio.currentTime);
                });
                audio.addEventListener('ended', () => {
                    if (current < tracks.length - 1) load(current + 1);
                });

                // Click or arrow keys on the bar to seek.
                progress.addEventListener('click', (e) => {
                    if (!audio.duration) return;
                    const r = progress.getBoundingClientRect();
                    audio.currentTime = ((e.clientX - r.left) / r.width) * audio.duration;
                });
                progress.addEventListener('keydown', (e) => {
                    if (!audio.duration) return;
                    if (e.key === 'ArrowRight') audio.currentTime = Math.min(audio.duration, audio.currentTime + 5);
                    if (e.key === 'ArrowLeft') audio.currentTime = Math.max(0, audio.currentTime - 5);
                });

                // The radio starting stops the EP. Media events don't bubble, so listen
                // in the capture phase.
                document.addEventListener(
                    'play',
                    (e) => {
                        if ((e.target as HTMLElement).classList?.contains('audio-element')) audio.pause();
                    },
                    true,
                );
            }
        }

        // Swap the YouTube thumbnail for the real player on click.
        document.querySelectorAll<HTMLButtonElement>('[data-yt-id]').forEach((btn) => {
            btn.addEventListener('click', () => {
                const frame = document.createElement('iframe');
                frame.src = `https://www.youtube.com/embed/${btn.dataset.ytId}?autoplay=1&rel=0`;
                frame.title = btn.dataset.ytTitle ?? 'videoclip';
                frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
                frame.referrerPolicy = 'strict-origin-when-cross-origin';
                frame.allowFullscreen = true;
                btn.replaceWith(frame);
            });
        });
    </script>
</Base>
