{
    "name": "backend",
    "version": "1.0.0",
    "description": "southsidedinero admin: products, orders and Stripe webhook (Payload).",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
        "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
        "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
        "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
        "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
        "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
        "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
        "format": "prettier --write src"
    },
    "dependencies": {
        "@payloadcms/next": "3.91.0",
        "@payloadcms/richtext-lexical": "3.91.0",
        "@payloadcms/ui": "3.91.0",
        "cross-env": "^7.0.3",
        "dotenv": "16.4.7",
        "graphql": "^16.8.1",
        "next": "16.3.3",
        "payload": "3.91.0",
        "react": "19.2.6",
        "react-dom": "19.2.6",
        "sharp": "0.35.4",
        "stripe": "23.0.0",
        "@payloadcms/db-mongodb": "3.91.0",
        "@payloadcms/storage-s3": "3.91.0"
    },
    "devDependencies": {
        "@types/node": "22.19.9",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "prettier": "^3.4.2",
        "tsx": "4.23.15",
        "typescript": "5.7.3"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
